{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build plugin (Java 17)",
            "type": "shell",
            "command": "mvn clean package -DskipTests",
            "options": {
                "env": {
                    "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.20.101-hotspot"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run test server (1.20.1)",
            "type": "shell",
            "command": "${workspaceFolder}/run-test-server.bat",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
